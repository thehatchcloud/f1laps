# Copied to /opt/f1laps/.env on the server by deploy/server-setup.sh (edit there).
SITE_ADDRESS=:80              # or your domain, e.g. f1laps.example.com (automatic HTTPS)
F1LAPS_SEASONS=2025,2026
F1LAPS_REFRESH_DAYS=fri,sat,sun
F1LAPS_REFRESH_TIME=23:30
F1LAPS_REFRESH_TZ=UTC         # e.g. America/New_York or Europe/London
F1LAPS_LOG_LEVEL=INFO
